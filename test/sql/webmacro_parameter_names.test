# name: test/sql/webmacro_parameter_names.test
# description: duckdb_functions() reports the real parameter names, and calls stay positional
# group: [sql]

require webmacro

query TT
SELECT function_name, parameters FROM duckdb_functions()
WHERE function_name = 'load_macro_from_url'
ORDER BY function_name;
----
load_macro_from_url	[url]

# A positional call still binds; NULL input returns NULL without fetching anything
query I
SELECT load_macro_from_url(NULL::VARCHAR) IS NULL;
----
true
