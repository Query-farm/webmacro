# name: test/sql/webmacro_validation.test
# description: only a single CREATE MACRO statement can be loaded from a URL (served by test/fixture_server.py)
# group: [sql]

# Needs the local fixture server:
#   python3 test/fixture_server.py 8765 &
#   WEBMACRO_FIXTURE_URL=http://127.0.0.1:8765 make test_release
require-env WEBMACRO_FIXTURE_URL

require webmacro

statement ok
SET webmacro_allow_http = true;

# A scalar macro whose comment mentions the word macro keeps its real name
query I
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/commented_macro.sql');
----
Successfully loaded macro: commented_macro

query I
SELECT commented_macro(1);
----
2

# Table macros load and run
query I
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/table_macro.sql');
----
Successfully loaded macro: table_macro

query I
SELECT count(*) FROM table_macro(3);
----
3

# One statement can define several overloads
query I
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/overloaded_macro.sql');
----
Successfully loaded macro: overloaded_macro

query I
SELECT overloaded_macro(1, 2);
----
3

# The body runs unchanged, including blank lines inside a string
query I
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/blank_line_macro.sql');
----
Successfully loaded macro: blank_line_macro

query I
SELECT length(blank_line_macro());
----
4

# Text that merely looks like a command is not rejected
query I
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/keyword_macro.sql');
----
Successfully loaded macro: keyword_macro

# Unicode in the macro body survives
query I
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/unicode_macro.sql');
----
Successfully loaded macro: unicode_macro

query I
SELECT unicode_macro();
----
🦆 dück

# CREATE MACRO in a comment doesn't make other SQL acceptable, and it doesn't run
statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/comment_only.sql');
----
must be a CREATE MACRO statement

statement error
SELECT * FROM comment_only_table;
----
does not exist

# Neither does CREATE MACRO inside a string
statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/not_a_macro.sql');
----
must be a CREATE MACRO statement

statement error
SELECT * FROM no_macro_table;
----
does not exist

# Nothing runs when a macro is followed by another statement, not even the macro
statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/multi_statement.sql');
----
exactly one CREATE MACRO statement, found 2 statements

statement error
SELECT * FROM multi_statement_table;
----
does not exist

statement error
SELECT first_macro();
----
does not exist

# A response with no statements is rejected
statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/empty.sql');
----
found 0 statements

# Invalid SQL is reported as such
statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/broken.sql');
----
URL content is not valid SQL

# Binary garbage is just invalid SQL
statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/big?bytes=100');
----
URL content is not valid SQL

# HTTP errors carry the status
statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/missing.sql');
----
HTTP 404

statement error
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/status/403');
----
HTTP 403

# A table column of URLs loads each one
query I
SELECT load_macro_from_url('{WEBMACRO_FIXTURE_URL}/' || f) FROM (VALUES ('commented_macro.sql'), (NULL), ('table_macro.sql')) t(f) ORDER BY ALL NULLS LAST;
----
Successfully loaded macro: commented_macro
Successfully loaded macro: table_macro
NULL
